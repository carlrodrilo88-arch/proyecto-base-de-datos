PORT=3000
DATABASE_URL=postgres://meditec_web:CAMBIAR_CONTRASENA@localhost:5432/meditec_reportes
# Solo para migraciones; usar la misma base que DATABASE_URL y retirar al terminar:
# DATABASE_ADMIN_URL=postgres://meditec_test:CAMBIAR_CONTRASENA@localhost:5432/meditec_reportes
SESSION_SECRET=usar-un-secreto-aleatorio-de-al-menos-32-caracteres
NODE_ENV=development
STORAGE_DRIVER=local
# Opcional para pruebas aisladas: STORAGE_LOCAL_ROOT=ruta-a-una-carpeta-temporal
# En Railway usar STORAGE_DRIVER=s3 y enlazar las credenciales privadas del Bucket:
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
