# La aplicacion se ejecuta desde web/. Copiar estas variables a web/.env
# para desarrollo o configurarlas como variables privadas en Railway.
PORT=3000
DATABASE_URL=postgres://meditec_web:CAMBIAR_CONTRASENA@localhost:5432/meditec_reportes
SESSION_SECRET=usar-un-secreto-aleatorio-de-al-menos-32-caracteres
NODE_ENV=development
AUTHORIZED_DEVICE_ID=MEDI-GEN-001
STORAGE_DRIVER=local

# Railway Bucket (solo cuando STORAGE_DRIVER=s3)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
